{
  "name": "marketing-flow",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "main": "apps/marketing-flow-desktop/electron-main.js",
  "scripts": {
    "dev": "concurrently --raw \"nodemon --ignore release/ --ignore apps/marketing-flow-desktop/dist/ --ignore runtime/ apps/marketing-flow-desktop/server/server.js\" \"vite --config apps/marketing-flow-desktop/vite.config.js\"",
    "server": "nodemon --ignore release/ --ignore apps/marketing-flow-desktop/dist/ --ignore runtime/ apps/marketing-flow-desktop/server/server.js",
    "client": "vite --config apps/marketing-flow-desktop/vite.config.js",
    "test": "node --test tests/unit/*.test.js",
    "setup:audio": "node scripts/setupAudioSeparation.js",
    "prepare:audio-bundle": "node scripts/prepareAudioBundle.js",
    "build": "vite build --config apps/marketing-flow-desktop/vite.config.js",
    "lint": "eslint .",
    "preview": "vite preview --config apps/marketing-flow-desktop/vite.config.js",
    "start": "node apps/marketing-flow-desktop/server/server.js",
    "app:dist": "npm run prepare:audio-bundle && npm run build && electron-builder --win",
    "mcp": "node apps/marketing-flow-desktop/server/mcp-server.js"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.9",
    "body-parser": "^2.3.0",
    "btch-downloader": "^6.0.37",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^4.22.3",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "motion": "^12.40.0",
    "msedge-tts": "^2.1.1",
    "multer": "^2.2.0",
    "node-edge-tts": "^1.2.10",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "ws": "^8.21.2",
    "youtubei.js": "^15.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "nodemon": "^3.1.7",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.marketingflow.desktop",
    "productName": "Marketing Flow",
    "publish": [
      {
        "provider": "github",
        "owner": "DUYminh0201",
        "repo": "mkt-flow"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/marketing-flow-desktop/dist/**/*",
      "apps/marketing-flow-desktop/server/**/*",
      "apps/marketing-flow-desktop/electron-main.js",
      "packages/media-processing/src/**/*",
      "packages/video-downloader/src/**/*",
      "runtime/database/model_registry.json",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".audio-bundle",
        "to": "audio-engine",
        "filter": [
          "**/*",
          "!manifest.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
